# === Required ===
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
MODEL_PATH=backend/models/xgb_spiral.joblib
PERSONAS_PATH=backend/app/data/personas.json
TIER_CONFIG_PATH=backend/app/data/tier_config.json
RANDOM_SEED=42

# === Risk thresholds (server-side only) ===
RISK_HIGH_THRESHOLD=70
RULE_UTILIZATION_THRESHOLD=0.60
PROJECTION_APR=0.36

# === Twilio (optional — ships disabled) ===
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEMO_WHATSAPP_TO=
NOTIFY_TIMEOUT_S=3.0

# Optional: use a Twilio API Key (SID starts with SK) instead of the Auth
# Token above. If both are set, the API Key takes priority.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Optional: required if TWILIO_WHATSAPP_FROM is an approved WhatsApp
# Business sender rather than the sandbox number — Twilio/Meta requires a
# pre-approved Content Template SID for messages outside a user session.
TWILIO_CONTENT_SID=

# === Frontend (set in frontend/.env) ===
VITE_API_BASE_URL=http://localhost:8000
